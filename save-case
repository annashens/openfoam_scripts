# Prompt to save raw CSVs via pvpython
printf "Save raw CSVs from ParaView? (y/n) [y]: "
read paraview_save
paraview_save=${paraview_save:-y}
PARAVIEW_SAVE=false
if [ "$paraview_save" = "y" ] || [ "$paraview_save" = "Y" ]; then
    PARAVIEW_SAVE=true
fi
# PARAVIEW_SAVE=true
if [ "$PARAVIEW_SAVE" = true ]; then
    echo "Saving raw CSVs from ParaView..."
    pvpython scripts/python/save_to_csv.py "$csv_dir"
fi

# -----------------------------
# Step 2: Run CSV reduction inside conda-venv
# -----------------------------
# Build Python flags

# Ask user for options
printf "Save cleaned CSV files? (y/n) [n]: "
read save_cleaned_csv
save_cleaned_csv=${save_cleaned_csv:-n}
SAVE_CLEANED=false
if [ "$save_cleaned_csv" = "y" ] || [ "$save_cleaned_csv" = "Y" ]; then
    SAVE_CLEANED=true
fi 
printf "Delete original CSV files after processing? (y/n) [n]: "
read delete_original
delete_original=${delete_original:-n}
DELETE_ORIGINAL=false
if [ "$delete_original" = "y" ] || [ "$delete_original" = "Y" ]; then
    DELETE_ORIGINAL=true
fi
# DELETE_ORIGINAL=true    # toggle deleting original CSVs

printf "Use streaming Parquet (memory-efficient)? (y/n) [y]: "
read use_streaming
use_streaming=${use_streaming:-y}
USE_STREAMING=true
if [ "$use_streaming" = "n" ] || [ "$use_streaming" = "N" ]; then
    USE_STREAMING=false
fi

DROP_PREFIXES=("ddt")   # add more prefixes if needed


# -----------------------------
# NEW: default-drop control
# -----------------------------
DROP_COLS=(
    C2H C2H2 C2H3 C2H4 C2H5 C2H6 C3H7 C3H8 CH
    CH2 CH2CHO CH2CO CH2O CH2OH CH3 CH3CHO
    CH3O CH3OH CH4 HCCO HCCOH HCO
    # saved saved_2 saved_3 saved_4 saved_5 saved_6
)


# Build Python flags
PY_FLAGS=""
[ "$SAVE_CLEANED" = true ] && PY_FLAGS="$PY_FLAGS --save-cleaned"
[ "$DELETE_ORIGINAL" = true ] && PY_FLAGS="$PY_FLAGS --delete-original"
[ "$USE_STREAMING" = true ] && PY_FLAGS="$PY_FLAGS --use-streaming"
[ "${#DROP_PREFIXES[@]}" -gt 0 ] && PY_FLAGS="$PY_FLAGS --drop-prefixes ${DROP_PREFIXES[*]}"
# existing prefix logic
[ "${#DROP_PREFIXES[@]}" -gt 0 ] && PY_FLAGS="$PY_FLAGS --drop-prefixes ${DROP_PREFIXES[@]}"

if [ "$NO_DEFAULT_DROP" = true ]; then
    PY_FLAGS="$PY_FLAGS --no-default-drop"
fi

if [ "${#DROP_COLS[@]}" -gt 0 ]; then
    PY_FLAGS="$PY_FLAGS --drop-cols ${DROP_COLS[@]}"
fi
echo "Activating conda environment for CSV reduction..."
source ~/miniconda3/etc/profile.d/conda.sh
# Activate venv and run
conda activate conda-venv
python scripts/python/reduce_files.py "$csv_dir" $PY_FLAGS
conda deactivate

# -----------------------------
# Step 3: Deactivate environment
# -----------------------------
conda deactivate
echo "All steps complete."