printf "Enter date (e.g., 17feb2026): "
read d

# -----------------------------
# Create directories
# -----------------------------
dir="user_data/case_data/${i}_${d}"
csv_dir="${dir}/csv"
mkdir -p "$dir"
mkdir -p "$csv_dir"



