# !/bin/sh
REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$REPO_ROOT" || exit 1  # Run from repo root
# cd "${0%/*}" || exit 1    # Run from the script's directory

# clean folder, though keeps time folder in case i don't want to overwrite just yet
echo "Cleaning case..." 
rm -rf processor* postProcessing log.*  CoreEnsemble_at**

echo "BlockMesh..." 
blockMesh 2>&1 | tee log.blockMesh 

echo "Decomposing..." 
decomposePar -force 2>&1 | tee log.decomposePar 

mpirun -np 16 --oversubscribe CSE_H3 -parallel 2>&1 \
| uniq \
| tee log.run \
| grep --line-buffered -Ei "Time =|warning|FOAM|fatal|segmentation|stack" \


reconstructPar 2>&1 | tee log.reconstructPar 


touch case.foam   # or sometimes you might use paraFoam -touch
paraview --state="states/zvar_ztilde.pvsm" &./